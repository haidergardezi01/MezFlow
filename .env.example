# ==============================================================================
# MezFlow Environment Configuration Template (.env.example)
# Copy this file to .env and adjust the values for your local environment.
# ==============================================================================

# Project Information
PROJECT_NAME="MezFlow"
ENVIRONMENT="development"
DEBUG=True

# Security & Authentication
# Generate a secure secret in production: openssl rand -hex 32
SECRET_KEY="temporary-dev-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mezflow_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/mezflow_db

# Redis Cache / Pub-Sub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (Comma-separated for multiple origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
